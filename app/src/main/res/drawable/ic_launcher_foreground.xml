<?xml version="1.0" encoding="utf-8"?>
<!-- Uygulama ikonu: parlak aqua jel kure, icinde beyaz kalkan ve onay isareti.
     Adaptif ikonun "guvenli alani" merkezdeki 66dp'lik dairedir; tum cizim
     o alanin icinde kaliyor ki farkli telefon sekillerinde (daire, kare,
     damla) kesilmesin. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Kure: ustu acik aqua, alti derin mavi -->
    <path android:pathData="M54,24a30,30 0,1 1,-0.01 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="24"
                android:endX="54" android:endY="84"
                android:startColor="#FF8FDBF7"
                android:centerColor="#FF1E9BD7"
                android:endColor="#FF0A6FB0" />
        </aapt:attr>
    </path>

    <!-- Jel parlamasi: kurenin ust yarisinda beyaz elips -->
    <path android:pathData="M54,27c-13,0 -22,6 -22,13c0,4 9,6 22,6c13,0 22,-2 22,-6c0,-7 -9,-13 -22,-13z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="27"
                android:endX="54" android:endY="46"
                android:startColor="#D9FFFFFF"
                android:endColor="#14FFFFFF" />
        </aapt:attr>
    </path>

    <!-- Kalkan -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,39L67,44L67,54C67,62.5 61.5,68 54,71C46.5,68 41,62.5 41,54L41,44Z" />

    <!-- Onay isareti -->
    <path
        android:strokeColor="#FF1E9BD7"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M47.5,55L52.2,59.5L60.5,50.5" />
</vector>
