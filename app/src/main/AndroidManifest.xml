<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Trafiği gözlemlemek ve devam ettirmek için gerekli -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- VPN acilmadan once gercek agin DNS sunucusunu ogrenmek icin
         (ConnectivityManager.activeNetwork / getLinkProperties) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- VPN servisini foreground service olarak çalıştırmak için zorunlu -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 13+ (API 33+) foreground bildirimi göstermek için -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Yüklü uygulamaların listesini/ikonlarını görebilmek için -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gizlilikarnesi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gizlilikarnesi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VPN servisimiz: sistem sadece BIND_VPN_SERVICE izni olan
             bileşenlerin bağlanmasına izin verir, bu yüzden bu satır zorunlu -->
        <service
            android:name=".capture.TrafficVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Disa aktarilan CSV'yi "Paylas" menusuyle baska uygulamalara
             vermek icin. Sadece exports klasoru ve sadece gecici okuma izni. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>